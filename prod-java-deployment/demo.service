[Unit]
Description=RBVM Java Application Service
Documentation=https://example.com/docs
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=appuser
Group=appgroup

# 工作目录
WorkingDirectory=/opt/apps/demo

# 环境变量
Environment="JAVA_HOME=/usr/lib/jvm/java-17-openjdk"
Environment="APP_NAME=demo"
Environment="APP_PORT=9181"
Environment="JVM_XMS=4g"
Environment="JVM_XMX=4g"
Environment="SPRING_PROFILES=prod"

# 启动命令
ExecStart=/opt/apps/demo/appctl.sh start

# 停止命令 (使用脚本中的优雅停机)
ExecStop=/opt/apps/demo/appctl.sh stop

# 重启策略
Restart=on-failure
RestartSec=10
StartLimitInterval=60
StartLimitBurst=3

# 资源限制
LimitNOFILE=65536
LimitNPROC=4096

# 优雅停机超时
TimeoutStopSec=90

# 日志输出到 journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=demo

[Install]
WantedBy=multi-user.target
