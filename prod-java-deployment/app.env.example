# 生产环境 Java 应用配置示例
# 复制为 .env 文件后 source 加载，或在启动前 export

# ==================== 基础配置 ====================
export APP_NAME=demo
export APP_PORT=9181
export JAR_NAME=demo.jar

# ==================== 路径配置 ====================
export APP_HOME=/opt/apps/${APP_NAME}
export LOG_DIR=/var/log/${APP_NAME}
export PID_FILE=/var/run/${APP_NAME}.pid

# ==================== Java 配置 ====================
export JAVA_HOME=/usr/lib/jvm/java-17-openjdk

# ==================== JVM 内存配置 ====================
# 生产环境建议: Xms = Xmx，避免运行时堆扩展带来的 GC 停顿
export JVM_XMS=4g
export JVM_XMX=4g
export JVM_METASPACE_SIZE=256m
export JVM_MAX_METASPACE_SIZE=512m
export JVM_XSS=256k

# ==================== GC 配置 ====================
# 可选: G1, ZGC(JDK17+), Shenandoah
export JVM_GC_TYPE=G1
export JVM_MAX_GC_PAUSE=200

# ==================== Spring 配置 ====================
export SPRING_PROFILES=prod

# ==================== 健康检查配置 ====================
export HEALTH_CHECK_URL=http://localhost:${APP_PORT}/actuator/health
export HEALTH_CHECK_TIMEOUT=120
export HEALTH_CHECK_INTERVAL=2

# ==================== 优雅停机配置 ====================
export GRACEFUL_SHUTDOWN_TIMEOUT=60

# ==================== 其他 JVM 参数 ====================
# 可在此添加额外的 JVM 参数，如:
# export JVM_OTHER_OPTS="-javaagent:/opt/agent/skywalking-agent.jar"
